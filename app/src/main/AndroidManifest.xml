<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Только для необязательного импорта словаря по HTTPS-ссылке. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Уведомления (Android 13+ спрашивает разрешение во время работы). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Updates на Android 16+ (обычное разрешение, выдаётся автоматически). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Восстановление расписания напоминаний после перезагрузки. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Необязательная плавающая капсула; включается пользователем отдельно. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".LingvoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_world"
        android:roundIcon="@mipmap/ic_world"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Lingvo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- Открыть JSON-словарь из файлового менеджера или Sharesheet. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

