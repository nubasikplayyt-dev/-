{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Значимое событие по активу",
  "type": "object",
  "required": ["id", "asset_id", "date", "type", "importance", "title", "summary", "criteria", "verdict", "sources", "notify"],
  "properties": {
    "id": { "type": "string", "description": "<asset_id>-<YYYYMMDD>-<короткий-слаг>, уникален" },
    "asset_id": { "type": "string", "description": "id из config/watchlist.json" },
    "date": { "type": "string", "format": "date", "description": "дата самого события (публикации отчёта, решения СД и т. п.)" },
    "detected_at": { "type": "string", "format": "date-time" },
    "type": {
      "enum": ["financial_report", "dividend", "debt", "management", "shareholder", "sanctions", "regulation", "commodity_cycle", "nav_rent", "price_filter", "other"]
    },
    "importance": { "enum": ["critical", "high", "medium"], "description": "critical = критерий переходит в fail или отмена/объявление дивиденда; high = warn или крупный сдвиг; medium = подтверждение/контекст" },
    "title": { "type": "string", "maxLength": 120 },
    "summary": { "type": "string", "description": "2–5 предложений своими словами, только факты + вывод по критериям" },
    "metrics": {
      "type": "object",
      "description": "ключевые числа события, например dividend_rub, net_debt_bn_rub, net_debt_to_ebitda, fcf_bn_rub, nav_rub, price_rub, yield_pct",
      "additionalProperties": { "type": ["number", "string", "null"] }
    },
    "criteria": {
      "type": "object",
      "description": "оценка по кодам из CRITERIA.md: C1–C8, P1–P3",
      "patternProperties": {
        "^(C[1-8]|P[1-3])$": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["pass", "warn", "fail", "n/a"] },
            "note": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "verdict": { "enum": ["hold", "watch", "buy_zone", "do_not_buy", "sell_candidate"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string" } } }
    },
    "notify": { "type": "boolean", "description": "true для critical и high" }
  }
}
