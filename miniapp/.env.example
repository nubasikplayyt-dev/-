# Репозиторий с данными агента мониторинга
VITE_DATA_OWNER=nubasikplayyt-dev
VITE_DATA_REPO=invest-watch
VITE_DATA_BRANCH=main

# Если репозиторий приватный — URL Cloudflare Worker, который проксирует чтение.
# Оставьте пустым для публичного репозитория: тогда данные берутся с raw.githubusercontent.com.
VITE_DATA_PROXY=

# 1 — работать на моковых данных из src/mock, без обращения к GitHub.
# Удобно для разработки вёрстки.
VITE_USE_MOCK=
